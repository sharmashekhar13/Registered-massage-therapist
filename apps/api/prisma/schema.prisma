generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Use Unsupported(...) for PostGIS geography types so Prisma can still manage migrations

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    ClientProfile?
  therapist TherapistProfile?
}

model ClientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  savedAddresses SavedAddress[]
  favorites Favorite[]
  createdAt DateTime @default(now())
}

model TherapistProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  bio            String?
  photoUrl       String?
  serviceRadius  Int      @default(25) // kilometers
  location       Unsupported("geography(Point,4326)")?
  services       Service[]
  availabilities Availability[]
  licenses       LicenseRecord[]
  insurance      InsuranceRecord[]
  background     BackgroundCheck?
  earnings       Payout[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LicenseRecord {
  id             String   @id @default(uuid())
  therapistId    String
  therapist      TherapistProfile @relation(fields: [therapistId], references: [id])
  jurisdictionId String
  issuingBody    String
  licenseNumber  String
  issueDate      DateTime
  expiryDate     DateTime
  status         String
  documentUrl    String?
  createdAt      DateTime @default(now())
}

model InsuranceRecord {
  id             String   @id @default(uuid())
  therapistId    String
  therapist      TherapistProfile @relation(fields: [therapistId], references: [id])
  provider       String
  policyNumber   String
  coverageUntil  DateTime
  documentUrl    String?
  createdAt      DateTime @default(now())
}

model VerificationCase {
  id             String   @id @default(uuid())
  therapistId    String
  therapist      TherapistProfile @relation(fields: [therapistId], references: [id])
  status         String
  reviewerId     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BackgroundCheck {
  id             String   @id @default(uuid())
  therapistId    String   @unique
  therapist      TherapistProfile @relation(fields: [therapistId], references: [id])
  provider       String?
  status         String
  completedAt    DateTime?
  reportUrl      String?
  createdAt      DateTime @default(now())
}

model Jurisdiction {
  id         String   @id @default(uuid())
  country    String
  region     String // state or province
  rules      Json?   // configurable rules per jurisdiction
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id])
  name        String
  description String?
  durationMin Int
  priceCents  Int
  createdAt   DateTime @default(now())
}

model Availability {
  id           String   @id @default(uuid())
  therapistId  String
  therapist    TherapistProfile @relation(fields: [therapistId], references: [id])
  weekday      Int // 0=Sunday .. 6=Saturday
  startTime    String // HH:MM
  endTime      String // HH:MM
  createdAt    DateTime @default(now())
}

model SavedAddress {
  id        String   @id @default(uuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id])
  label     String?
  address   String
  location  Unsupported("geography(Point,4326)")
  createdAt DateTime @default(now())
}

model Booking {
  id            String   @id @default(uuid())
  clientId      String
  client        ClientProfile @relation(fields: [clientId], references: [id])
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id])
  serviceId     String
  service       Service   @relation(fields: [serviceId], references: [id])
  status        String
  scheduledAt   DateTime
  address       String
  location      Unsupported("geography(Point,4326)")
  priceCents    Int
  tipCents      Int?      @default(0)
  stripePaymentId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id])
  amountCents   Int
  stripeChargeId String?
  status        String
  createdAt     DateTime @default(now())
}

model Payout {
  id            String   @id @default(uuid())
  therapistId   String
  therapist     TherapistProfile @relation(fields: [therapistId], references: [id])
  amountCents   Int
  scheduledAt   DateTime
  stripePayoutId String?
  status        String
  createdAt     DateTime @default(now())
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
}

model Favorite {
  id          String   @id @default(uuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id])
  therapistId String
  therapist   TherapistProfile @relation(fields: [therapistId], references: [id])
  createdAt   DateTime @default(now())
}

model Conversation {
  id          String   @id @default(uuid())
  participantA String
  participantB String
  createdAt   DateTime @default(now())
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  userType  String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SafetyCase {
  id            String   @id @default(uuid())
  reporterId    String
  reportedId    String
  bookingId     String?
  details       String
  status        String
  createdAt     DateTime @default(now())
}

model Dispute {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id])
  reason      String
  status      String
  createdAt   DateTime @default(now())
}

model Tip {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id])
  amountCents Int
  createdAt  DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  String
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}
